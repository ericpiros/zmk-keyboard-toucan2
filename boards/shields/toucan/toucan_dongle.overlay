#include "toucan.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    mock_kscan: mock_kscan_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

&kscan0 {
    status = "disabled";
};

&trackpad_split {
    status = "okay";
};

&trackpad_listener {
    status = "okay";
};

&zip_zoom_mapper {
    status = "okay";
};

